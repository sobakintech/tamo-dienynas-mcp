# TAMO login of the student account
TAMO_USERNAME=
TAMO_PASSWORD=
# Optional: part of the role title to use when the account has several roles
TAMO_ROLE=

# Bearer token for clients that can send headers (/mcp)
MCP_TOKEN=
# Secret path segment for clients that cannot (/<MCP_PATH_TOKEN>/mcp)
MCP_PATH_TOKEN=

PORT=8000
MAX_TAMO_REQUESTS_PER_MINUTE=30
